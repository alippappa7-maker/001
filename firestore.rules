rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the authenticated user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User document and all its user-specific subcollections
    // Stores: profile info, preferences (theme, language), favorite azkar, daily progress
    // STRICT SECURITY: Never store passwords or raw unconsented private coordinates
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Subcollections under user (if any are partitioned)
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
